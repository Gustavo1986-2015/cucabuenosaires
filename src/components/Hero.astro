---
import Icono from './Icono.astro';
import negocio from '../data/negocio.json';
const wa = `https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent('¡Hola Cuca! Quiero hacer un pedido 🧀')}`;
---
<section class="hero" id="inicio">
  <div class="hero-fondo" aria-hidden="true">
    <img src="/img/picada-dark.webp" alt="" width="1400" height="1000" fetchpriority="high" />
  </div>

  <div class="contenedor hero-in">
    <div class="hero-texto">
      <p class="estado" data-estado>
        <span class="punto"></span><span data-estado-txt>San Blas 4101 · Floresta</span>
      </p>
      <h1 class="hero-titulo">
        <span class="linea"><span>Expertos</span></span>
        <span class="linea"><span>en <em>fiambres</em>.</span></span>
      </h1>
      <p class="hero-bajada">
        Quesos de verdad, fiambres premium cortados en el momento, picadas armadas a mano,
        sándwiches de miga y medialunas. Atendido por sus dueños, en el corazón de Floresta.
      </p>
      <div class="hero-ctas">
        <a class="btn" href="#picada">Armá tu picada <Icono nombre="flecha" /></a>
        <a class="btn btn-wa" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> Pedir por WhatsApp</a>
      </div>
      <ul class="hero-chips" aria-label="Destacados">
        <li class="chip"><Icono nombre="estrella" class="estrella" /> <strong>{String(negocio.google.rating).replace('.', ',')}</strong> en Google</li>
        <li class="chip"><Icono nombre="camion" /> Envíos a domicilio</li>
        <li class="chip"><Icono nombre="mano" /> Probá antes de comprar</li>
      </ul>
    </div>

    <div class="hero-3d" data-escena-hero>
      <canvas class="escena" aria-label="Tabla de picada en 3D armándose sola" role="img"></canvas>
      <img class="firma" src="/brand/firma.svg" alt="" width="1104" height="720" aria-hidden="true" />
      <div class="etiqueta-flotante e1 tiza" aria-hidden="true">¡recién cortado!</div>
      <div class="etiqueta-flotante e2 tiza" aria-hidden="true">quesos de campo</div>
    </div>
  </div>

  <a class="hero-scroll" href="#ofertas" aria-label="Ver ofertas">
    <span></span>
  </a>
</section>

<div class="cinta" aria-hidden="true">
  <div class="cinta-pista tiza">
    {[0, 1].map(() => (
      <span>
        Jamón crudo ✦ Queso ahumado ✦ Roquefort al Malbec ✦ Aceitunas griegas ✦ Salame de campo ✦ Sándwiches de miga ✦ Medialunas ✦ Reggianito ✦ Bondiola ✦ Picadas para eventos ✦&nbsp;
      </span>
    ))}
  </div>
</div>

<style>
  .hero {
    position: relative; min-height: 100svh; display: flex; align-items: center;
    padding: calc(var(--header-h) + 32px) 0 72px; overflow: hidden; isolation: isolate;
  }
  .hero-fondo { position: absolute; inset: 0; z-index: -1; }
  .hero-fondo img { width: 100%; height: 100%; object-fit: cover; opacity: 0.22; filter: saturate(0.8) blur(2px); transform: scale(1.06); }
  .hero-fondo::after {
    content: ""; position: absolute; inset: 0;
    background:
      radial-gradient(90% 70% at 72% 50%, rgba(13, 13, 12, 0.2), var(--negro) 78%),
      linear-gradient(180deg, rgba(13, 13, 12, 0.6), transparent 30%, transparent 70%, var(--negro));
  }

  .hero-in { display: grid; grid-template-columns: 1.02fr 1fr; gap: clamp(20px, 3vw, 48px); align-items: center; }

  .estado {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 22px; padding: 7px 14px 7px 12px;
    border-radius: 999px; background: rgba(243, 239, 230, 0.06); border: 1px solid var(--linea);
    font-size: 0.85rem; font-weight: 600; color: var(--tiza-2);
  }
  .punto { width: 9px; height: 9px; border-radius: 50%; background: var(--tiza-3); }
  .estado.abierto .punto { background: #3ddc84; box-shadow: 0 0 0 0 rgba(61, 220, 132, 0.6); animation: latido 2s infinite; }
  .estado.cerrado .punto { background: var(--salame); }
  @keyframes latido { 70% { box-shadow: 0 0 0 10px rgba(61, 220, 132, 0); } 100% { box-shadow: 0 0 0 0 rgba(61, 220, 132, 0); } }

  .hero-titulo {
    font-family: var(--f-display); font-weight: 900; line-height: 0.92; letter-spacing: -0.02em;
    font-size: clamp(3.4rem, 9vw, 7.4rem); margin: 0 0 24px;
  }
  .hero-titulo em { font-style: italic; color: var(--mostaza); font-weight: 700; }
  .linea { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .linea > span { display: inline-block; transform: translateY(105%); animation: subir 1.1s var(--ease) forwards; }
  .linea:nth-child(2) > span { animation-delay: 0.12s; }
  @keyframes subir { to { transform: none; } }

  .hero-bajada { color: var(--tiza-2); font-size: clamp(1.02rem, 1.4vw, 1.18rem); max-width: 52ch; margin: 0 0 30px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .hero-chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .hero-chips :global(svg) { width: 16px; height: 16px; }

  .hero-texto > * { opacity: 0; animation: aparecer 0.9s var(--ease) forwards; }
  .hero-texto > :nth-child(1) { animation-delay: 0.05s; }
  .hero-texto > :nth-child(2) { opacity: 1; animation: none; }
  .hero-texto > :nth-child(3) { animation-delay: 0.35s; }
  .hero-texto > :nth-child(4) { animation-delay: 0.45s; }
  .hero-texto > :nth-child(5) { animation-delay: 0.55s; }
  @keyframes aparecer { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .hero-3d { position: relative; aspect-ratio: 1 / 0.92; }
  .escena { width: 100%; height: 100%; opacity: 0; transition: opacity 1s; }
  .escena:global(.listo) { opacity: 1; }
  .firma {
    position: absolute; right: 3%; bottom: 1%; width: 34%; opacity: 0.9; pointer-events: none;
    transform: rotate(-6deg); filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.6));
  }
  .etiqueta-flotante {
    position: absolute; font-size: clamp(1.3rem, 2.1vw, 1.8rem); color: var(--tiza); pointer-events: none;
    padding: 2px 14px; border: 2px dashed var(--linea-2); border-radius: 999px; background: rgba(13, 13, 12, 0.45);
    animation: flotar 5s ease-in-out infinite;
  }
  .e1 { top: 8%; left: 4%; transform: rotate(-7deg); color: var(--menta); }
  .e2 { top: 16%; right: 2%; transform: rotate(5deg); color: var(--rosa); animation-delay: -2.5s; }
  @keyframes flotar { 50% { translate: 0 -10px; } }

  .hero-scroll {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0; width: 28px; height: 46px;
    border: 2px solid var(--linea-2); border-radius: 999px; display: flex; justify-content: center; padding-top: 8px;
  }
  .hero-scroll span { width: 4px; height: 8px; border-radius: 4px; background: var(--tiza); animation: rueda 1.8s infinite; }
  @keyframes rueda { 0% { opacity: 0; transform: translateY(-4px); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }

  .cinta { position: relative; overflow: hidden; border-block: 1px solid var(--linea); background: var(--pizarra); padding: 10px 0; }
  .cinta-pista { display: flex; width: max-content; animation: cinta 38s linear infinite; font-size: clamp(1.5rem, 2.6vw, 2.1rem); color: var(--tiza-2); white-space: nowrap; }
  @keyframes cinta { to { transform: translateX(-50%); } }

  @media (max-width: 900px) {
    .hero { min-height: auto; padding-top: calc(var(--header-h) + 24px); padding-bottom: 56px; }
    .hero-in { grid-template-columns: 1fr; }
    .hero-3d { order: -1; margin: -8px 0 -16px; aspect-ratio: 1 / 0.8; }
    .hero-scroll { display: none; }
    .firma { width: 38%; }
  }
</style>

<script>
  import negocio from '../data/negocio.json';

  // Abierto / cerrado en hora de Buenos Aires
  const partes = Object.fromEntries(
    new Intl.DateTimeFormat('en-US', { timeZone: 'America/Argentina/Buenos_Aires', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
      .formatToParts(new Date()).map((p) => [p.type, p.value]),
  );
  const dias = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const hoy = dias.indexOf(partes.weekday);
  const ahora = Number(partes.hour) * 60 + Number(partes.minute);
  const aMin = (hhmm: string) => { const [h, m] = hhmm.split(':').map(Number); return h * 60 + m; };
  const turnosHoy = negocio.horarios[hoy].turnos as string[][];
  const abierto = turnosHoy.find(([a, c]) => ahora >= aMin(a) && ahora < aMin(c));
  const el = document.querySelector('[data-estado]')!;
  const txt = document.querySelector('[data-estado-txt]')!;
  if (abierto) {
    el.classList.add('abierto');
    txt.textContent = `Abierto ahora · hasta las ${abierto[1]} h`;
  } else {
    el.classList.add('cerrado');
    const proximo = turnosHoy.find(([a]) => aMin(a) > ahora);
    if (proximo) txt.textContent = `Cerrado · abrimos hoy a las ${proximo[0]} h`;
    else {
      for (let i = 1; i <= 7; i++) {
        const d = negocio.horarios[(hoy + i) % 7];
        if (d.turnos.length) { txt.textContent = `Cerrado · abrimos el ${d.nombre.toLowerCase()} a las ${d.turnos[0][0]} h`; break; }
      }
    }
  }

  // Escena 3D: se carga sólo si hay WebGL
  const cont = document.querySelector<HTMLElement>('[data-escena-hero]')!;
  const canvas = cont.querySelector('canvas')!;
  const gl = document.createElement('canvas').getContext('webgl2');
  if (gl) {
    import('../scripts/picada3d.js').then(({ montarPicada }) => montarPicada(canvas, { nivel: 10 })).catch(() => cont.classList.add('sin-3d'));
  } else {
    cont.classList.add('sin-3d');
  }
</script>

<style is:global>
  .sin-3d { background: url('/img/picada-dark.webp') center / cover; border-radius: var(--radio); }
</style>
