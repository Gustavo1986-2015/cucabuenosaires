---
import Icono from './Icono.astro';
import negocio from '../data/negocio.json';
const wa = `https://wa.me/${negocio.whatsapp}?text=${encodeURIComponent('¡Hola Cuca! Quería hacer una consulta 😊')}`;
---
<!-- Cajón del pedido -->
<div class="velo" data-velo hidden></div>
<aside class="cajon" data-cajon aria-label="Tu pedido" aria-hidden="true" inert>
  <header class="cajon-cab">
    <h2>Tu pedido</h2>
    <button type="button" class="cerrar" data-cerrar-carrito aria-label="Cerrar pedido"><Icono nombre="cerrar" /></button>
  </header>
  <div class="cajon-cuerpo">
    <ul class="lista-pedido" data-lista-cajon></ul>
    <div class="vacio" data-vacio>
      <p class="tiza">Todavía no sumaste nada</p>
      <p>Mirá la pizarra de ofertas o armá tu picada.</p>
      <a href="#productos" class="btn btn-linea btn-chico" data-cerrar-carrito>Ver productos</a>
    </div>
  </div>
  <footer class="cajon-pie" data-pie-cajon>
    <p class="nota">Los precios se confirman por WhatsApp. Hacemos envíos a domicilio.</p>
    <a href="#pedido" class="btn btn-bloque" data-cerrar-carrito>Completar datos y enviar <Icono nombre="flecha" /></a>
    <button type="button" class="vaciar" data-vaciar>Vaciar pedido</button>
  </footer>
</aside>

<!-- Selector de opción (ofertas con varias variantes) -->
<dialog class="selector" data-selector>
  <form method="dialog">
    <h3 data-selector-titulo>Elegí una opción</h3>
    <div class="selector-ops" data-selector-ops></div>
    <div class="selector-acciones">
      <button class="btn btn-linea btn-chico" value="cancelar">Cancelar</button>
      <button class="btn btn-chico" value="ok">Agregar</button>
    </div>
  </form>
</dialog>

<!-- Aviso -->
<div class="aviso" data-aviso role="status" aria-live="polite" hidden>
  <Icono nombre="check" /> <span data-aviso-txt></span>
  <button type="button" data-abrir-carrito>Ver pedido</button>
</div>

<!-- Barra de acciones en celulares + botón flotante de WhatsApp -->
<nav class="barra-movil" aria-label="Acciones rápidas">
  <button type="button" data-abrir-carrito><Icono nombre="carrito" /> Pedido <span class="bm-cont" data-contador-movil>0</span></button>
  <a href={wa} target="_blank" rel="noopener" class="bm-wa"><Icono nombre="whatsapp" /> WhatsApp</a>
</nav>
<a class="wa-flotante" href={wa} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <Icono nombre="whatsapp" />
  <span class="wa-burbuja">¿Te ayudamos con tu pedido?</span>
</a>

<style>
  .velo { position: fixed; inset: 0; z-index: 80; background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(3px); animation: fundido 0.3s; }
  @keyframes fundido { from { opacity: 0; } }
  .cajon {
    position: fixed; top: 0; right: 0; bottom: 0; z-index: 90; width: min(440px, 100%);
    display: flex; flex-direction: column; background: var(--pizarra); border-left: 1px solid var(--linea-2);
    transform: translateX(100%); transition: transform 0.45s var(--ease); box-shadow: -30px 0 60px rgba(0, 0, 0, 0.5);
  }
  .cajon.abierto { transform: none; }
  .cajon-cab { display: flex; align-items: center; justify-content: space-between; padding: 20px 22px; border-bottom: 1px solid var(--linea); }
  .cajon-cab h2 { margin: 0; font-family: var(--f-display); font-size: 1.6rem; }
  .cerrar { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--linea); background: transparent; display: grid; place-items: center; }
  .cerrar:hover { background: rgba(243, 239, 230, 0.08); }
  .cajon-cuerpo { flex: 1; overflow-y: auto; padding: 8px 22px; }
  .cajon-pie { padding: 16px 22px calc(18px + env(safe-area-inset-bottom)); border-top: 1px solid var(--linea); display: grid; gap: 10px; }
  .nota { margin: 0; font-size: 0.82rem; color: var(--tiza-3); }
  .vaciar { background: none; border: 0; color: var(--tiza-3); font-size: 0.85rem; text-decoration: underline; justify-self: center; }

  .vacio { text-align: center; padding: 40px 10px; color: var(--tiza-3); }
  .vacio .tiza { font-size: 2.2rem; color: var(--tiza); margin: 0; }

  .lista-pedido { list-style: none; margin: 0; padding: 0; }
  .lista-pedido :global(li) { display: grid; grid-template-columns: 58px 1fr auto; gap: 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--linea); }
  .lista-pedido :global(img) { width: 58px; height: 58px; border-radius: 12px; object-fit: cover; }
  .lista-pedido :global(.li-nombre) { font-weight: 700; line-height: 1.25; }
  .lista-pedido :global(.li-op) { font-size: 0.8rem; color: var(--tiza-3); }
  .lista-pedido :global(.cant) { display: flex; align-items: center; gap: 4px; border: 1px solid var(--linea); border-radius: 999px; padding: 3px; }
  .lista-pedido :global(.cant button) { width: 30px; height: 30px; border-radius: 50%; border: 0; background: rgba(243, 239, 230, 0.08); display: grid; place-items: center; }
  .lista-pedido :global(.cant button svg) { width: 14px; height: 14px; }
  .lista-pedido :global(.cant span) { min-width: 22px; text-align: center; font-weight: 800; }

  .selector { border: 1px solid var(--linea-2); border-radius: 20px; background: var(--pizarra-2); color: var(--tiza); padding: 24px; width: min(420px, calc(100% - 32px)); }
  .selector::backdrop { background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(3px); }
  .selector h3 { margin: 0 0 16px; font-family: var(--f-display); font-size: 1.4rem; }
  .selector-ops { display: grid; gap: 8px; margin-bottom: 18px; }
  .selector-ops :global(label) { display: flex; gap: 12px; align-items: center; padding: 12px 14px; border: 1.5px solid var(--linea); border-radius: 12px; cursor: pointer; font-weight: 600; }
  .selector-ops :global(label:has(input:checked)) { border-color: var(--mostaza); background: rgba(227, 168, 43, 0.1); }
  .selector-ops :global(input) { accent-color: var(--mostaza); }
  .selector-acciones { display: flex; gap: 10px; justify-content: flex-end; }

  .aviso {
    position: fixed; left: 50%; bottom: 96px; z-index: 95; translate: -50% 0; display: flex; align-items: center; gap: 10px;
    padding: 10px 10px 10px 16px; border-radius: 999px; background: var(--tiza); color: var(--negro); font-weight: 700; font-size: 0.9rem;
    box-shadow: var(--sombra); animation: subeAviso 0.4s var(--ease); max-width: calc(100% - 32px);
  }
  .aviso :global(svg) { width: 18px; height: 18px; color: #1a8f4f; flex: none; }
  .aviso span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .aviso button { border: 0; border-radius: 999px; padding: 6px 12px; background: var(--negro); color: var(--tiza); font-weight: 700; font-size: 0.82rem; white-space: nowrap; }
  @keyframes subeAviso { from { opacity: 0; translate: -50% 20px; } }

  .wa-flotante {
    position: fixed; right: 22px; bottom: 22px; z-index: 60; width: 62px; height: 62px; border-radius: 50%;
    display: grid; place-items: center; background: #25d366; color: #fff; box-shadow: 0 14px 34px -10px rgba(37, 211, 102, 0.8);
    transition: transform 0.3s var(--ease);
  }
  .wa-flotante:hover { transform: scale(1.08) rotate(-6deg); }
  .wa-flotante :global(svg) { width: 32px; height: 32px; }
  .wa-flotante::before { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 2px solid #25d366; animation: onda 2.4s infinite; }
  @keyframes onda { to { transform: scale(1.6); opacity: 0; } }
  .wa-burbuja {
    position: absolute; right: 74px; white-space: nowrap; padding: 8px 14px; border-radius: 14px 14px 4px 14px; background: var(--tiza); color: var(--negro);
    font-weight: 700; font-size: 0.85rem; opacity: 0; translate: 10px 0; pointer-events: none; transition: all 0.35s var(--ease);
  }
  .wa-flotante:hover .wa-burbuja { opacity: 1; translate: 0 0; }

  .barra-movil { display: none; }
  @media (max-width: 700px) {
    .wa-flotante { display: none; }
    .barra-movil {
      position: fixed; left: 12px; right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); z-index: 60; display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      padding: 8px; border-radius: 20px; background: rgba(23, 26, 24, 0.9); backdrop-filter: blur(14px); border: 1px solid var(--linea-2); box-shadow: var(--sombra);
    }
    .barra-movil > * { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 14px; font-weight: 800; font-size: 0.95rem; border: 0; }
    .barra-movil button { background: var(--tiza); color: var(--negro); }
    .barra-movil :global(svg) { width: 20px; height: 20px; }
    .bm-cont { min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--mostaza); display: grid; place-items: center; font-size: 0.75rem; }
    .bm-wa { background: #25d366; color: #06220f; }
    .aviso { bottom: calc(92px + env(safe-area-inset-bottom)); }
    :global(body) { padding-bottom: 84px; }
  }
</style>

<script>
  import { suscribir, cambiarCantidad, quitar, vaciar, totalUnidades, agregarAlCarrito } from '../scripts/carrito.js';

  const cajon = document.querySelector<HTMLElement>('[data-cajon]')!;
  const velo = document.querySelector<HTMLElement>('[data-velo]')!;
  const lista = document.querySelector<HTMLElement>('[data-lista-cajon]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const pie = document.querySelector<HTMLElement>('[data-pie-cajon]')!;
  let ultimoFoco: HTMLElement | null = null;

  function abrir() {
    ultimoFoco = document.activeElement as HTMLElement;
    cajon.classList.add('abierto'); cajon.removeAttribute('inert'); cajon.setAttribute('aria-hidden', 'false');
    velo.hidden = false; document.body.style.overflow = 'hidden';
    cajon.querySelector<HTMLElement>('.cerrar')?.focus();
  }
  function cerrar() {
    cajon.classList.remove('abierto'); cajon.setAttribute('inert', ''); cajon.setAttribute('aria-hidden', 'true');
    velo.hidden = true; document.body.style.overflow = '';
    ultimoFoco?.focus?.();
  }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-abrir-carrito]')) { abrir(); aviso.hidden = true; }
    else if (t.closest('[data-cerrar-carrito]')) cerrar();
  });
  velo.addEventListener('click', cerrar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && cajon.classList.contains('abierto')) cerrar(); });
  document.querySelector('[data-vaciar]')!.addEventListener('click', () => { if (confirm('¿Vaciar todo el pedido?')) vaciar(); });

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const iconoMenos = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 12h14"/></svg>';
  const iconoMas = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>';

  suscribir((items: any[]) => {
    const n = totalUnidades();
    document.querySelectorAll<HTMLElement>('[data-contador]').forEach((c) => {
      c.hidden = n === 0; c.textContent = String(n);
      c.classList.remove('pop'); void c.offsetWidth; c.classList.add('pop');
    });
    document.querySelectorAll<HTMLElement>('[data-contador-movil]').forEach((c) => (c.textContent = String(n)));
    vacio.hidden = items.length > 0;
    pie.hidden = items.length === 0;
    lista.innerHTML = items.map((i) => `
      <li>
        <img src="/img/${esc(i.img || 'picada-dark.webp')}" alt="" width="58" height="58" loading="lazy" />
        <div><div class="li-nombre">${esc(i.nombre)}</div>${i.opcion ? `<div class="li-op">${esc(i.opcion)}</div>` : ''}</div>
        <div class="cant">
          <button type="button" data-cant="-1" data-clave="${esc(i.clave)}" aria-label="Quitar uno">${iconoMenos}</button>
          <span>${i.cant}</span>
          <button type="button" data-cant="1" data-clave="${esc(i.clave)}" aria-label="Sumar uno">${iconoMas}</button>
        </div>
      </li>`).join('');
  });
  lista.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cant]');
    if (b) cambiarCantidad(b.dataset.clave!, Number(b.dataset.cant));
  });

  // Aviso "agregado"
  const aviso = document.querySelector<HTMLElement>('[data-aviso]')!;
  const avisoTxt = document.querySelector<HTMLElement>('[data-aviso-txt]')!;
  let timer: number;
  document.addEventListener('cuca:agregado', (e: any) => {
    avisoTxt.textContent = `Sumaste ${e.detail.nombre}`;
    aviso.hidden = false;
    aviso.style.animation = 'none'; void aviso.offsetWidth; aviso.style.animation = '';
    clearTimeout(timer);
    timer = window.setTimeout(() => (aviso.hidden = true), 3200);
  });

  // Selector de variantes
  const dlg = document.querySelector<HTMLDialogElement>('[data-selector]')!;
  const ops = document.querySelector<HTMLElement>('[data-selector-ops]')!;
  const tit = document.querySelector<HTMLElement>('[data-selector-titulo]')!;
  let pendiente: any = null;
  document.addEventListener('cuca:elegir', (e: any) => {
    pendiente = e.detail;
    tit.textContent = e.detail.nombre.replace(/^Oferta: /, '');
    ops.innerHTML = e.detail.opciones.map((o: string, i: number) =>
      `<label><input type="radio" name="op" value="${esc(o)}" ${i === 0 ? 'checked' : ''}/> ${esc(o)}</label>`).join('');
    dlg.showModal();
  });
  dlg.addEventListener('close', () => {
    if (dlg.returnValue === 'ok' && pendiente) {
      const v = (ops.querySelector('input:checked') as HTMLInputElement)?.value || '';
      agregarAlCarrito({ id: pendiente.id, nombre: pendiente.nombre, opcion: v, img: pendiente.img }, pendiente.origen);
    }
    pendiente = null;
  });
</script>
